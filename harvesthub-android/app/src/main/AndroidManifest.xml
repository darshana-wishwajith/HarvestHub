<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.harvesthub.mobile">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HarvestHubMobile">

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.common.RoleSelectionActivity"
            android:exported="true" />

        <activity
            android:name=".ui.common.LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Farmer Activities -->
        <activity android:name=".ui.farmer.RegisterActivity" />
        <activity android:name=".ui.farmer.VerifyOtpActivity" />
        <activity android:name=".ui.farmer.AccountVerifiedActivity" />
        <activity android:name=".ui.farmer.ForgotPasswordActivity" />
        <activity android:name=".ui.farmer.ResetPasswordActivity" />
        <activity android:name=".ui.farmer.CreateNewPasswordActivity" />
        <activity android:name=".ui.farmer.LocationSetupActivity" />
        <activity android:name=".ui.farmer.FarmerLoginActivity" />
        <activity android:name=".ui.farmer.OrderInTransitActivity" />
        <activity android:name=".ui.farmer.RatingFeedbackActivity" />

        <activity android:name=".ui.farmer.NotificationsActivity" />
        <activity android:name=".ui.farmer.ListingsHistoryActivity" />
        <activity android:name=".ui.farmer.EditProfileActivity" />
        <activity android:name=".ui.farmer.CameraCaptureActivity" />
        <activity android:name=".ui.farmer.ChatActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.farmer.WaitForBuyerApprovalActivity" />
        <activity android:name=".ui.farmer.WaitingForAdvancePaymentActivity" />
        <activity android:name=".ui.farmer.StartHarvestingActivity" />
        <activity android:name=".ui.farmer.HarvestReadyActivity" />
        <activity android:name=".ui.farmer.VehicleArrivalActivity" />
        <activity android:name=".ui.farmer.CreateSupplyOfferActivity" />
        <activity android:name=".ui.farmer.ActiveOrderTrackerActivity" />

        <!-- Buyer Activities -->
        <activity android:name=".ui.buyer.BuyerLoginActivity" />
        <activity android:name=".ui.buyer.BuyerDashboardActivity" />
        <activity android:name=".ui.buyer.BuyerOrdersActivity" />
        <activity android:name=".ui.buyer.MarketplaceSearchActivity" />
        <activity android:name=".ui.buyer.SignInBuyerActivity" />
        <activity android:name=".ui.buyer.CreateAccountActivity" />
        <activity android:name=".ui.buyer.SetDeliveryAddressActivity" />
        <activity android:name=".ui.buyer.CreateNewPasswordActivity" />
        <activity android:name=".ui.buyer.VerificationCodeActivity" />
        <activity android:name=".ui.buyer.VerificationCodeErrorActivity" />
        <activity android:name=".ui.buyer.VerifiedHarvestsActivity" />
        <activity android:name=".ui.buyer.PostDemandRequestActivity" />
        <activity android:name=".ui.buyer.MyDemandRequestsActivity" />
        <activity android:name=".ui.buyer.SupplyOffersActivity" />
        <activity android:name=".ui.buyer.NegotiationChatActivity" />
        <activity android:name=".ui.buyer.OrderSummaryActivity" />
        <activity android:name=".ui.buyer.SecureCheckoutActivity" />
        <activity android:name=".ui.buyer.TransactionLedgerActivity" />
        <activity android:name=".ui.buyer.TransitTrackingActivity" />
        <activity android:name=".ui.buyer.VerifyCargoActivity" />
        <activity android:name=".ui.buyer.DisputeResolvedActivity" />

        <!-- Transporter Activities -->
        <activity android:name=".ui.transporter.TransporterLoginActivity" />
        <activity android:name=".ui.transporter.DeliveryDashboardActivity" />
        <activity android:name=".ui.transporter.RouteMapActivity" />
        <activity android:name=".ui.transporter.ArrivingPickupActivity" />
        <activity android:name=".ui.transporter.NavigationTrackingActivity" />
        <activity android:name=".ui.transporter.DestinationArrivedActivity" />
        <activity android:name=".ui.transporter.LiabilityCheckpointActivity" />
        <activity android:name=".ui.transporter.JobHistoryActivity" />
        <activity android:name=".ui.transporter.CargoRejectedActivity" />
        <activity android:name=".ui.transporter.DeliveryDisputedActivity" />
        <activity android:name=".ui.transporter.RateExperienceActivity" />
        <activity android:name=".ui.transporter.AccountSuspendedActivity" />
        <activity android:name=".ui.transporter.TransporterSettingsActivity" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_GOOGLE_MAPS_API_KEY_HERE" />

    </application>

</manifest>


