<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/notif_item_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/notif_item_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivNotificationIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:background="#E8F5E9"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                tools:backgroundTint="#13A34A"
                tools:src="@drawable/ic_check_circle"
                tools:tint="@color/white" />

            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_toStartOf="@id/tvTimestamp"
                android:layout_toEndOf="@id/ivNotificationIcon"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:textColor="@color/notif_item_title"
                android:textSize="14sp"
                tools:text="Delivery Successful" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/notif_item_time"
                android:textSize="11sp"
                tools:text="2m ago" />

            <TextView
                android:id="@+id/tvNotificationBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvNotificationTitle"
                android:layout_marginStart="14dp"
                android:layout_marginTop="3dp"
                android:layout_toEndOf="@id/ivNotificationIcon"
                android:fontFamily="@font/plus_jakarta_sans"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/notif_item_body"
                android:textSize="12.5sp"
                tools:text="LKR 140,000 has been credited to your wallet." />

        </RelativeLayout>

        <TextView
            android:id="@+id/tvMarkAsRead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Mark as Read"
            android:textColor="@color/primary_green"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
