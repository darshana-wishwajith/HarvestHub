<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/topNavBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/top_nav_bg"
    android:elevation="4dp"
    android:padding="10dp"
    android:paddingHorizontal="16dp">

    <!-- Logo Icon -->
    <ImageView
        android:id="@+id/ivLogoIcon"
        android:layout_width="42dp"
        android:layout_height="40dp"
        android:contentDescription="HarvestHub Logo"
        android:src="@drawable/harvesthub_logo_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Wordmark Logo -->
    <ImageView
        android:id="@+id/ivWordmark"
        android:layout_width="101dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:contentDescription="HarvestHub"
        android:src="@drawable/ic_harvesthub_wordmark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivLogoIcon"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Notification Bell -->
    <FrameLayout
        android:id="@+id/btnNotification"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bell"
            app:tint="@color/top_nav_icon_tint" />

        <!-- Notification Badge (Red Dot) -->
        <View
            android:id="@+id/vNotificationBadge"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_notification_dot"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
