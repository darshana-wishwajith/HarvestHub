<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password, step 2: enter the 6-digit code.
     Figma: "4.Forgot password - Code Verfication Screen" (660:111, empty),
     "5. ... VC Code - Success Screen" (83:265, green boxes) and
     "6. ... VC Code - Error Screen" (660:21, red boxes + banner). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout style="@style/FpTopBar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/FpBackButton" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/FpTitle"
                android:text="@string/fp_title_code" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/FpBody"
                android:layout_marginTop="16dp"
                android:textSize="16sp" />

            <!-- 6 digit boxes, spread across the width -->
            <LinearLayout
                android:id="@+id/llOtpContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <EditText android:id="@+id/etOtp1" style="@style/FpOtpBox" />
                <Space style="@style/FpOtpGap" />
                <EditText android:id="@+id/etOtp2" style="@style/FpOtpBox" />
                <Space style="@style/FpOtpGap" />
                <EditText android:id="@+id/etOtp3" style="@style/FpOtpBox" />
                <Space style="@style/FpOtpGap" />
                <EditText android:id="@+id/etOtp4" style="@style/FpOtpBox" />
                <Space style="@style/FpOtpGap" />
                <EditText android:id="@+id/etOtp5" style="@style/FpOtpBox" />
                <Space style="@style/FpOtpGap" />
                <EditText android:id="@+id/etOtp6" style="@style/FpOtpBox" />
            </LinearLayout>

            <!-- Error banner (Figma 660:48) -->
            <LinearLayout
                android:id="@+id/llErrorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_fp_error_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_fp_error" />

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/fp_err_code_invalid"
                    android:textColor="@color/fp_error"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:padding="4dp"
                android:textColor="@color/fp_body"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                style="@style/FpPrimaryButton"
                android:layout_marginTop="40dp"
                android:text="@string/fp_verify_code"
                app:icon="@drawable/ic_fp_check_circle_white"
                app:iconSize="20dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
