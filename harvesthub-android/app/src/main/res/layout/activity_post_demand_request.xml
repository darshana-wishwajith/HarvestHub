<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">

        <!-- Top Back Navigation (optional, for easy UX) -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="-4dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvPostDemandTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/post_demand_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvPostDemandSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/post_demand_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Field 1: Target Crop -->
        <LinearLayout
            android:id="@+id/layoutTargetCrop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <AutoCompleteTextView
                android:id="@+id/actvTargetCrop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:completionThreshold="1"
                android:hint="@string/target_crop_hint"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivDropdownCrop"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Select crop"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <!-- Field 2: Required Quantity (KG) -->
        <LinearLayout
            android:id="@+id/layoutRequiredQuantity"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/etRequiredQuantity"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/required_quantity_hint"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Field 3: Deadline / Needed By -->
        <LinearLayout
            android:id="@+id/layoutDeadline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/etDeadline"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/deadline_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivCalendar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Pick deadline date"
                android:src="@drawable/ic_calendar" />
        </LinearLayout>

        <!-- Section Title: Minimum Quality Grade -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:text="@string/minimum_quality_grade"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Quality Grade Selection Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <!-- Grade A Option -->
            <LinearLayout
                android:id="@+id/btnGradeA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_grade_a_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCheckGradeA"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvGradeA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grade_a"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Grade B Option -->
            <LinearLayout
                android:id="@+id/btnGradeB"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_grade_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCheckGradeB"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvGradeB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grade_b"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Grade C Option -->
            <LinearLayout
                android:id="@+id/btnGradeC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_grade_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCheckGradeC"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvGradeC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grade_c"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Field 4: Target Price per KG (Optional) -->
        <LinearLayout
            android:id="@+id/layoutTargetPrice"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/etTargetPrice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/target_price_hint"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Field 5: Additional details -->
        <EditText
            android:id="@+id/etAdditionalDetails"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="@string/additional_details_hint"
            android:imeOptions="actionDone"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/input_hint"
            android:textSize="14sp" />

        <!-- Action Button: Publish to Global Feed -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishDemand"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:backgroundTint="@color/brand_dark_green"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/publish_to_global_feed"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>
