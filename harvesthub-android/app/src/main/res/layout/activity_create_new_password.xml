<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password, step 4. Figma: "7.Forgot password - Create New Password" (node 82:142). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout style="@style/FpTopBar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/FpBackButton" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="64dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/FpTitle"
                android:text="@string/fp_title_new_password" />

            <TextView
                style="@style/FpBody"
                android:layout_marginTop="15dp"
                android:text="@string/fp_desc_new_password" />

            <!-- New password -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <EditText
                    android:id="@+id/etNewPassword"
                    style="@style/FpInput"
                    android:autofillHints="newPassword"
                    android:hint="@string/fp_hint_new_password"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:paddingEnd="54dp" />

                <ImageView
                    android:id="@+id/ivToggleNew"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/fp_toggle_password"
                    android:scaleType="center"
                    android:src="@drawable/ic_fp_eye_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNewPasswordError"
                style="@style/FpFieldError" />

            <!-- Confirm password -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    style="@style/FpInput"
                    android:autofillHints="newPassword"
                    android:hint="@string/fp_hint_confirm_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingEnd="54dp" />

                <ImageView
                    android:id="@+id/ivToggleConfirm"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/fp_toggle_password"
                    android:scaleType="center"
                    android:src="@drawable/ic_fp_eye_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvConfirmPasswordError"
                style="@style/FpFieldError" />

            <!-- Server error (e.g. code expired, same as current password) -->
            <LinearLayout
                android:id="@+id/llErrorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_fp_error_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_fp_error" />

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/fp_error"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/FpPrimaryButton"
                android:layout_marginTop="17dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="@string/fp_save_login"
                android:textSize="18sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
