<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/mainContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="100dp">

                <!-- Greeting Section -->
                <TextView
                    android:id="@+id/tvGreetingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="Welcome back, Kamal!"
                    android:textColor="#111827"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Total Earnings Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTotalEarnings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#EAF5EE"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_trending_up"
                                app:tint="#4A7C59" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Total Earnings"
                                android:textColor="#4A7C59"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTotalRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:text="LKR 125,000"
                            android:textColor="#1E3F20"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stats Row (Active Listings & Completed) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Active Listings Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardActiveListings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#F9FAFB"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E5E7EB"
                        app:strokeWidth="1dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/ivActiveIcon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_package"
                                app:tint="#D97706" />

                            <TextView
                                android:id="@+id/tvActiveListings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:text="2"
                                android:textColor="#111827"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/ivActiveIcon"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:letterSpacing="0.05"
                                android:text="ACTIVE LISTINGS"
                                android:textColor="#6B7280"
                                android:textSize="11sp" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Completed Orders Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCompletedOrders"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#F9FAFB"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E5E7EB"
                        app:strokeWidth="1dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/ivCompletedIcon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                app:tint="#10B981" />

                            <TextView
                                android:id="@+id/tvCompletedOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:text="18"
                                android:textColor="#111827"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/ivCompletedIcon"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:letterSpacing="0.05"
                                android:text="COMPLETED"
                                android:textColor="#6B7280"
                                android:textSize="11sp" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Market Trends Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMarketTrends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Header Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:text="Market Trends"
                                android:textColor="#111827"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/btnMarketInsightsMenu"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Market Insights Menu"
                                android:padding="4dp"
                                android:src="@drawable/ic_more_horiz"
                                app:tint="#6B7280" />
                        </RelativeLayout>

                        <!-- Chart -->
                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/marketChart"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="12dp" />

                        <!-- Alert Pill Chip -->
                        <LinearLayout
                            android:id="@+id/layoutMarketTrendAlert"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_market_alert_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_trending_up"
                                app:tint="#10B981" />

                            <TextView
                                android:id="@+id/tvMarketTrendAlert"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans_medium"
                                android:text="High demand for Big Onions in Dambulla"
                                android:textColor="#111827"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Create New Listing Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateListing"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Create New Listing"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#1D3B2D"
                    app:cornerRadius="16dp"
                    app:elevation="2dp"
                    app:icon="@drawable/ic_add_circle"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="#FFFFFF" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>