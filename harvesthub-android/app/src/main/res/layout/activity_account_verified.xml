<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password, step 3. Figma: "5.Forgot Password - Account Verified Page" (node 137:2). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="84dp">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_fp_verified_circle">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_fp_verified" />
        </FrameLayout>

        <TextView
            style="@style/FpTitle"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/fp_title_verified" />

        <TextView
            style="@style/FpBody"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/fp_desc_verified" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetPassword"
            style="@style/FpPrimaryButton"
            android:layout_marginTop="48dp"
            android:text="@string/fp_reset_password" />

    </LinearLayout>
</ScrollView>
