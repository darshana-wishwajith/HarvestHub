<?xml version="1.0" encoding="utf-8"?>
<!-- Transporter "Vehicle Profile" (design 16 Nov): sign-up step 2 and "Edit vehicle" in Settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8F5"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#111827" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Vehicle Profile"
            android:textColor="#1B4332"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Progress (registration only) -->
            <LinearLayout
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vp_soft_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="STEP 2 OF 3"
                        android:textColor="#111827"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStepPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="67% Completed"
                        android:textColor="#475569"
                        android:textSize="12sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbStep"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="67"
                    android:progressBackgroundTint="#E2E8F0"
                    android:progressTint="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_truck_green"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="Vehicle &amp; Capacity Verification"
                    android:textColor="#1B4332"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Register Your Transport Vehicle"
                android:textColor="#1B4332"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ensure accurate agricultural cargo matching and temperature compliance across regional farms."
                android:textColor="#475569"
                android:textSize="14sp" />

            <!-- Vehicle type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Vehicle Type"
                    android:textColor="#111827"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="#E8F5E9"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="REQUIRED"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2-column grid of vehicle classes (rows added in code) -->
            <LinearLayout
                android:id="@+id/typeGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvTypeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading vehicle types..."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/errType"
                style="@style/VpError" />

            <!-- Configuration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Vehicle Configuration"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REQUIRED"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <include
                android:id="@+id/cfgReefer"
                layout="@layout/item_vehicle_config_card" />

            <include
                android:id="@+id/cfgFlatbed"
                layout="@layout/item_vehicle_config_card" />

            <include
                android:id="@+id/cfgBox"
                layout="@layout/item_vehicle_config_card" />

            <TextView
                android:id="@+id/errConfig"
                style="@style/VpError" />

            <!-- Capacity & legal specs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/vp_card_bg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/vp_soft_bg"
                    android:drawableStart="@drawable/ic_shield_check"
                    android:drawablePadding="10dp"
                    android:drawableTint="#1B4332"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:text="Capacity &amp; Legal Specs"
                    android:textColor="#1B4332"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Max Payload (kg) – optional, defaults to the class limit"
                        android:textColor="#475569"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etPayload"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/vp_soft_bg"
                        android:drawableStart="@drawable/ic_box"
                        android:drawablePadding="10dp"
                        android:hint="e.g. 2,500"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="#111827"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/errPayload"
                        style="@style/VpError" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="License Plate Number"
                        android:textColor="#475569"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/vp_soft_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etPlate"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:drawableStart="@drawable/ic_badge_license"
                            android:drawablePadding="10dp"
                            android:hint="WP ND-4892"
                            android:inputType="textCapCharacters"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#111827"
                            android:textColorHint="#94A3B8"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProvince"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="#E2E8F0"
                            android:gravity="center_vertical"
                            android:maxWidth="110dp"
                            android:paddingHorizontal="8dp"
                            android:textColor="#1B4332"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/errPlate"
                        style="@style/VpError" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compliance documents -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/vp_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Compliance Documents"
                        android:textColor="#1B4332"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="#16A34A" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDocsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mandatory for harvest dispatch access"
                    android:textColor="#475569"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/vp_soft_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#D1FAE5">

                        <ImageView
                            android:id="@+id/ivLicenceState"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_badge_license"
                            app:tint="#1B4332" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Driving License Photo"
                            android:textColor="#111827"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLicenceStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not uploaded yet"
                            android:textColor="#64748B"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnUploadLicence"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_pill_badge"
                        android:backgroundTint="#334155"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Upload"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/errLicence"
                    style="@style/VpError" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_btn_sign_in"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSaveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save &amp; Continue to Vehicle Address"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_forward_white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="6dp"
            android:drawableTint="#1B4332"
            android:gravity="center_vertical"
            android:text="Protected by Agri-Logistics Transport Security protocol"
            android:textColor="#334155"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
