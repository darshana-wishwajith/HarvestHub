<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="64dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_received"
        android:fontFamily="@font/plus_jakarta_sans"
        android:padding="12dp"
        android:text="Hello Kamal, I reviewed your verified Grade A batch. Can you supply the full 500 KG at LKR 245/kg for immediate transport to Dambulla?"
        android:textColor="#1A1A1A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="10:14 AM"
        android:textColor="#828282"
        android:textSize="11sp" />

</LinearLayout>
