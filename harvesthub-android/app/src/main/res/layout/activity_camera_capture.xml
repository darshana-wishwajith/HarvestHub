<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 13 "Smart Guided Camera" (design 16 Nov): step title, framed viewfinder with corner brackets
     and crosshair, WIDE ANGLE / CLOSE UP / VIDEO steps, location lock, shutter, flip; app top + bottom bars. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <include
        android:id="@+id/top_nav_bar"
        layout="@layout/top_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Live camera behind everything -->
        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Step title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#80000000"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvStepTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="Step 1: Capture Wide Angle"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvStepSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:text="Show the entire cultivated area"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Framed viewfinder -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/frame"
                    android:layout_width="310dp"
                    android:layout_height="236dp"
                    android:layout_gravity="center"
                    android:background="@drawable/cam_frame_border">

                    <!-- corner brackets: 4 corners x (horizontal + vertical bar) -->
                    <View android:layout_width="26dp" android:layout_height="4dp" android:layout_gravity="top|start" android:background="#FFFFFF" />
                    <View android:layout_width="4dp" android:layout_height="26dp" android:layout_gravity="top|start" android:background="#FFFFFF" />
                    <View android:layout_width="26dp" android:layout_height="4dp" android:layout_gravity="top|end" android:background="#FFFFFF" />
                    <View android:layout_width="4dp" android:layout_height="26dp" android:layout_gravity="top|end" android:background="#FFFFFF" />
                    <View android:layout_width="26dp" android:layout_height="4dp" android:layout_gravity="bottom|start" android:background="#FFFFFF" />
                    <View android:layout_width="4dp" android:layout_height="26dp" android:layout_gravity="bottom|start" android:background="#FFFFFF" />
                    <View android:layout_width="26dp" android:layout_height="4dp" android:layout_gravity="bottom|end" android:background="#FFFFFF" />
                    <View android:layout_width="4dp" android:layout_height="26dp" android:layout_gravity="bottom|end" android:background="#FFFFFF" />

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/cam_crosshair"
                        android:contentDescription="Centre" />

                    <!-- Recording countdown -->
                    <TextView
                        android:id="@+id/tvRecording"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_badge"
                        android:backgroundTint="#DC2626"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="● REC 10s"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Upload progress -->
                <LinearLayout
                    android:id="@+id/uploadOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="#CC000000"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:indeterminateTint="#4CAF50" />

                    <TextView
                        android:id="@+id/tvUploading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Uploading…"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Steps + controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#80000000"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabWideAngle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:letterSpacing="0.03"
                        android:text="WIDE ANGLE"
                        android:textColor="@color/accent_green"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tabCloseUp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:letterSpacing="0.03"
                        android:text="CLOSE UP"
                        android:textColor="#D1D5DB"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tabVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:letterSpacing="0.03"
                        android:text="VIDEO"
                        android:textColor="#D1D5DB"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="22dp"
                    android:paddingHorizontal="36dp">

                    <ImageButton
                        android:id="@+id/btnLock"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_pill_badge"
                        android:backgroundTint="#374151"
                        android:contentDescription="Location lock"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_lock" />

                    <ImageButton
                        android:id="@+id/btnCapture"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center"
                        android:background="@drawable/cam_shutter"
                        android:contentDescription="Capture" />

                    <ImageButton
                        android:id="@+id/btnFlip"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#374151"
                        android:contentDescription="Switch camera"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_flip"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
