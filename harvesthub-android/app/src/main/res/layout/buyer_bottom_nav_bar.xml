<?xml version="1.0" encoding="utf-8"?>
<!-- Buyer bottom navigation: Home · Market · Orders · Requests · Account.
     Same look as the transporter bar (dark rounded pill behind the active item); state set in BuyerDashboardActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/buyerBottomNavBar"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@android:color/white"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <FrameLayout
        android:id="@+id/buyerNavHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="Home">

        <LinearLayout
            android:id="@+id/buyerPillHome"
            style="@style/BuyerNavPill">

            <ImageView
                android:id="@+id/buyerIconHome"
                style="@style/BuyerNavIcon"
                android:src="@drawable/transporter_ic_bottom_home" />

            <TextView
                android:id="@+id/buyerLabelHome"
                style="@style/BuyerNavLabel"
                android:text="Home" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/buyerNavMarket"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="Market">

        <LinearLayout
            android:id="@+id/buyerPillMarket"
            style="@style/BuyerNavPill">

            <ImageView
                android:id="@+id/buyerIconMarket"
                style="@style/BuyerNavIcon"
                android:src="@drawable/ic_shopping_bag" />

            <TextView
                android:id="@+id/buyerLabelMarket"
                style="@style/BuyerNavLabel"
                android:text="Market" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/buyerNavOrders"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="Orders">

        <LinearLayout
            android:id="@+id/buyerPillOrders"
            style="@style/BuyerNavPill">

            <ImageView
                android:id="@+id/buyerIconOrders"
                style="@style/BuyerNavIcon"
                android:src="@drawable/ic_truck" />

            <TextView
                android:id="@+id/buyerLabelOrders"
                style="@style/BuyerNavLabel"
                android:text="Orders" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/buyerNavDemands"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="Requests">

        <LinearLayout
            android:id="@+id/buyerPillDemands"
            style="@style/BuyerNavPill">

            <ImageView
                android:id="@+id/buyerIconDemands"
                style="@style/BuyerNavIcon"
                android:src="@drawable/ic_document_ad" />

            <TextView
                android:id="@+id/buyerLabelDemands"
                style="@style/BuyerNavLabel"
                android:text="Requests" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/buyerNavAccount"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="Account">

        <LinearLayout
            android:id="@+id/buyerPillAccount"
            style="@style/BuyerNavPill">

            <ImageView
                android:id="@+id/buyerIconAccount"
                style="@style/BuyerNavIcon"
                android:src="@drawable/ic_person_outline" />

            <TextView
                android:id="@+id/buyerLabelAccount"
                style="@style/BuyerNavLabel"
                android:text="Account" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
