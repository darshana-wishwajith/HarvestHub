<?xml version="1.0" encoding="utf-8"?>
<!-- Transporter login. Figma: HarvestHub-UI, frame "1.1 Login" (node 623:2819), 390 x 884. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tl_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="66dp"
        android:paddingBottom="24dp">

        <!-- ===== Hero banner card ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tl_hero_card"
            android:elevation="1dp">

            <View
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_tl_glow"
                android:translationX="24dp"
                android:translationY="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tl_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tl_shield_check" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:letterSpacing="0.04"
                        android:text="@string/tl_badge"
                        android:textColor="@color/tl_primary_deep"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:letterSpacing="-0.025"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/tl_heading"
                    android:textColor="@color/tl_on_surface"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/tl_subtitle"
                    android:textColor="@color/tl_on_surface_variant"
                    android:textSize="14sp" />

                <!-- Micro stats strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tl_stat_card"
                        android:elevation="1dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tl_stat_icon_routes">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tl_truck" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans_semibold"
                                android:letterSpacing="0.01"
                                android:text="@string/tl_stat_routes_value"
                                android:textColor="@color/tl_on_surface"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:letterSpacing="0.04"
                                android:text="@string/tl_stat_routes_label"
                                android:textColor="@color/tl_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tl_stat_card"
                        android:elevation="1dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tl_stat_icon_payout">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tl_tractor" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans_semibold"
                                android:letterSpacing="0.01"
                                android:text="@string/tl_stat_payout_value"
                                android:textColor="@color/tl_on_surface"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:letterSpacing="0.04"
                                android:text="@string/tl_stat_payout_label"
                                android:textColor="@color/tl_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ===== Log In / Register Driver switcher ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tl_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/tabLogin"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tl_segment_active"
                android:elevation="1dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tl_login" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:letterSpacing="0.01"
                    android:text="@string/tl_tab_login"
                    android:textColor="@color/tl_primary_deep"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvRegisterTransporter"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tl_register" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:letterSpacing="0.01"
                    android:text="@string/tl_tab_register"
                    android:textColor="@color/tl_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Form card ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tl_form_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Identifier label row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvIdentifierLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:letterSpacing="0.01"
                    android:text="@string/tl_label_mobile"
                    android:textColor="@color/tl_on_surface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUseEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:letterSpacing="0.04"
                    android:padding="4dp"
                    android:text="@string/tl_use_email"
                    android:textColor="@color/tl_green_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Identifier input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tl_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutCountryPrefix"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tl_input_prefix"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tl_flag" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:letterSpacing="0.02"
                        android:text="@string/tl_country_code"
                        android:textColor="@color/tl_on_surface"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tl_caret" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etIdentifier"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="phone"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:hint="@string/tl_hint_mobile"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="@color/tl_on_surface"
                    android:textColorHint="@color/tl_outline"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivIdentifierIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tl_phone" />
            </LinearLayout>

            <!-- Password label row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:letterSpacing="0.01"
                    android:text="@string/tl_label_password"
                    android:textColor="@color/tl_on_surface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:letterSpacing="0.04"
                    android:padding="4dp"
                    android:text="@string/tl_forgot_pin"
                    android:textColor="@color/tl_green_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Password input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tl_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tl_lock" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:hint="@string/tl_hint_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="@color/tl_on_surface"
                    android:textColorHint="@color/tl_outline"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="37dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/tl_toggle_password"
                    android:focusable="true"
                    android:paddingEnd="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tl_eye"
                    app:tint="@color/tl_outline" />
            </LinearLayout>

            <!-- Stay signed in -->
            <CheckBox
                android:id="@+id/cbStaySignedIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:button="@drawable/tl_checkbox"
                android:checked="true"
                android:fontFamily="@font/plus_jakarta_sans"
                android:minHeight="32dp"
                android:paddingStart="8dp"
                android:text="@string/tl_stay_signed_in"
                android:textColor="@color/tl_on_surface_variant"
                android:textSize="12sp" />

            <!-- Primary CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.01"
                android:text="@string/tl_sign_in"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:backgroundTint="@color/border_active"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_tl_truck_white"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/tl_outline_soft" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:letterSpacing="0.05"
                    android:text="@string/tl_fast_access"
                    android:textAllCaps="true"
                    android:textColor="@color/tl_outline"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/tl_outline_soft" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Legal footer ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:paddingHorizontal="8dp"
            android:text="@string/tl_footer"
            android:textColor="@color/tl_outline"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
