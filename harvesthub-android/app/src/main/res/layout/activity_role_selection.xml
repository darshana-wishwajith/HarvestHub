<?xml version="1.0" encoding="utf-8"?>
<!-- Landing / role selection. Figma: HarvestHub-UI, frame "1.Landing Screen" (node 125:900), 390 x 884. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="87dp"
            android:layout_height="66dp"
            android:layout_marginTop="71dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/img_landing_logo" />

        <!-- Hero illustration: farm -> truck -> market -->
        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="278dp"
            android:layout_height="147dp"
            android:layout_marginTop="33dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/img_landing_hero" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.025"
            android:text="@string/welcome_to_harvesthub"
            android:textColor="@color/landing_heading"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:text="@string/choose_account_type"
            android:textColor="@color/landing_body"
            android:textSize="14sp" />

        <!-- Role cards -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFarmer"
            style="@style/LandingRoleCard"
            android:layout_marginTop="60dp">

            <LinearLayout style="@style/LandingRoleCardRow">

                <FrameLayout style="@style/LandingRoleIconBg">

                    <ImageView
                        style="@style/LandingRoleIcon"
                        android:src="@drawable/farmer_icon" />
                </FrameLayout>

                <LinearLayout style="@style/LandingRoleTextColumn">

                    <TextView
                        style="@style/LandingRoleTitle"
                        android:text="@string/farmer" />

                    <TextView
                        style="@style/LandingRoleSubtitle"
                        android:text="@string/farmer_desc" />
                </LinearLayout>

                <ImageView style="@style/LandingRoleChevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBuyer"
            style="@style/LandingRoleCard"
            android:layout_marginTop="8dp">

            <LinearLayout style="@style/LandingRoleCardRow">

                <FrameLayout style="@style/LandingRoleIconBg">

                    <ImageView
                        style="@style/LandingRoleIcon"
                        android:src="@drawable/buyer_icon" />
                </FrameLayout>

                <LinearLayout style="@style/LandingRoleTextColumn">

                    <TextView
                        style="@style/LandingRoleTitle"
                        android:text="@string/buyer" />

                    <TextView
                        style="@style/LandingRoleSubtitle"
                        android:text="@string/buyer_desc" />
                </LinearLayout>

                <ImageView style="@style/LandingRoleChevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTransporter"
            style="@style/LandingRoleCard"
            android:layout_marginTop="8dp">

            <LinearLayout style="@style/LandingRoleCardRow">

                <FrameLayout style="@style/LandingRoleIconBg">

                    <ImageView
                        style="@style/LandingRoleIcon"
                        android:src="@drawable/transporter_icon" />
                </FrameLayout>

                <LinearLayout style="@style/LandingRoleTextColumn">

                    <TextView
                        style="@style/LandingRoleTitle"
                        android:text="@string/transporter" />

                    <TextView
                        style="@style/LandingRoleSubtitle"
                        android:text="@string/transporter_desc" />
                </LinearLayout>

                <ImageView style="@style/LandingRoleChevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pushes the footer to the bottom on tall screens -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="74dp"
            android:layout_marginBottom="59dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:text="@string/terms_and_privacy"
            android:textColor="@color/landing_body"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
