<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password, step 1. Figma: "3.Forgot Password - VC sending Screen" (node 82:41). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout style="@style/FpTopBar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/FpBackButton" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="31dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/FpTitle"
                android:text="@string/fp_title_forgot" />

            <TextView
                style="@style/FpBody"
                android:layout_marginTop="23dp"
                android:text="@string/fp_desc_forgot" />

            <!-- Identifier input with mail icon (text starts at 49dp, icon at 16dp) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <EditText
                    android:id="@+id/etIdentifier"
                    style="@style/FpInput"
                    android:autofillHints="emailAddress"
                    android:hint="@string/fp_hint_identifier"
                    android:imeOptions="actionSend"
                    android:inputType="textEmailAddress"
                    android:paddingStart="49dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_fp_mail" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvIdentifierError"
                style="@style/FpFieldError"
                android:text="@string/fp_err_identifier" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendCode"
                style="@style/FpPrimaryButton"
                android:layout_marginTop="17dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/fp_send_code" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
