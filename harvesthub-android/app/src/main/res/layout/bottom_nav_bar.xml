<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navBarContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_bar_height"
    android:background="@color/nav_bar_bg"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <!-- Home -->
    <FrameLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="@dimen/nav_pill_padding_horizontal"
            android:paddingVertical="@dimen/nav_pill_padding_vertical"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/icon_home"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:src="@drawable/ic_home" />
            <TextView
                android:id="@+id/label_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="@dimen/nav_label_size"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Market -->
    <FrameLayout
        android:id="@+id/nav_market"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_market"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="@dimen/nav_pill_padding_horizontal"
            android:paddingVertical="@dimen/nav_pill_padding_vertical"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/icon_market"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:src="@drawable/ic_market" />
            <TextView
                android:id="@+id/label_market"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Market"
                android:textSize="@dimen/nav_label_size"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Listings -->
    <FrameLayout
        android:id="@+id/nav_listings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_listings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="@dimen/nav_pill_padding_horizontal"
            android:paddingVertical="@dimen/nav_pill_padding_vertical"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/icon_listings"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:src="@drawable/ic_list" />
            <TextView
                android:id="@+id/label_listings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listings"
                android:textSize="@dimen/nav_label_size"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Wallet -->
    <FrameLayout
        android:id="@+id/nav_wallet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_wallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="@dimen/nav_pill_padding_horizontal"
            android:paddingVertical="@dimen/nav_pill_padding_vertical"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/icon_wallet"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:src="@drawable/ic_wallet" />
            <TextView
                android:id="@+id/label_wallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wallet"
                android:textSize="@dimen/nav_label_size"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Settings -->
    <FrameLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="@dimen/nav_pill_padding_horizontal"
            android:paddingVertical="@dimen/nav_pill_padding_vertical"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/icon_settings"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:src="@drawable/ic_settings" />
            <TextView
                android:id="@+id/label_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="@dimen/nav_label_size"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>