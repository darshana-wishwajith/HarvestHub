<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navBarContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_bar_height"
    android:background="@color/nav_bar_bg"
    android:baselineAligned="false"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clipToPadding="false">

    <!-- Home -->
    <FrameLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/pill_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/nav_pill_padding_vertical"
            android:duplicateParentState="true">

            <ImageView
                android:id="@+id/icon_home"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/nav_home" />

            <TextView
                android:id="@+id/label_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home"
                android:textSize="@dimen/nav_label_size"
                android:includeFontPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- Market -->
    <FrameLayout
        android:id="@+id/nav_market"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/pill_market"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/nav_pill_padding_vertical"
            android:duplicateParentState="true">

            <ImageView
                android:id="@+id/icon_market"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:src="@drawable/ic_market"
                android:contentDescription="@string/nav_market" />

            <TextView
                android:id="@+id/label_market"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_market"
                android:textSize="@dimen/nav_label_size"
                android:includeFontPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- Listings -->
    <FrameLayout
        android:id="@+id/nav_listings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/pill_listings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="4dp"
            android:duplicateParentState="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/nav_pill_padding_vertical">

            <ImageView
                android:id="@+id/icon_listings"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:contentDescription="@string/nav_listings"
                android:src="@drawable/ic_list" />

            <TextView
                android:id="@+id/label_listings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="@string/nav_listings"
                android:textSize="@dimen/nav_label_size" />
        </LinearLayout>
    </FrameLayout>

    <!-- Wallet -->
    <FrameLayout
        android:id="@+id/nav_wallet"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/pill_wallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/nav_pill_padding_vertical"
            android:duplicateParentState="true">

            <ImageView
                android:id="@+id/icon_wallet"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:src="@drawable/ic_wallet"
                android:contentDescription="@string/nav_wallet" />

            <TextView
                android:id="@+id/label_wallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_wallet"
                android:textSize="@dimen/nav_label_size" />
        </LinearLayout>
    </FrameLayout>

    <!-- Settings -->
    <FrameLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/pill_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/nav_pill_padding_vertical"
            android:duplicateParentState="true">

            <ImageView
                android:id="@+id/icon_settings"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/nav_settings" />

            <TextView
                android:id="@+id/label_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_settings"
                android:textSize="@dimen/nav_label_size" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
