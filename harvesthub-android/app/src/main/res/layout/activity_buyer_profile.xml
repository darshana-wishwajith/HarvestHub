<?xml version="1.0" encoding="utf-8"?>
<!-- "Profile & Settings Page" screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1B4332" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProfileInitials"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1B4332"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_light_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="✓ Verified Buyer"
                android:textColor="#1B4332"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileContact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TRADING DESK PREFERENCES"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rowDeliveryLocation"
                    style="@style/BuyerProfileRow"
                    android:text="📍 Delivery location" />

                <TextView
                    android:id="@+id/rowWallet"
                    style="@style/BuyerProfileRow"
                    android:text="💳 Wallet &amp; escrow" />

                <TextView
                    android:id="@+id/rowNotifications"
                    style="@style/BuyerProfileRow"
                    android:text="🔔 Notification preferences" />

                <TextView
                    android:id="@+id/rowPassword"
                    style="@style/BuyerProfileRow"
                    android:text="🔑 Change password" />

                <TextView
                    android:id="@+id/rowHelp"
                    style="@style/BuyerProfileRow"
                    android:text="❓ Help &amp; support" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignOut"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Sign out"
            android:textAllCaps="false"
            android:textColor="#B91C1C"
            app:cornerRadius="14dp"
            app:strokeColor="#FCA5A5" />
    </LinearLayout>
</ScrollView>
