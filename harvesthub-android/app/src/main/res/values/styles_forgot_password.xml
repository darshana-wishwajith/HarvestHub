<?xml version="1.0" encoding="utf-8"?>
<!-- Shared look of the Farmer forgot-password screens (Figma frames 3-7). -->
<resources>

    <!-- 64dp white top bar with a 40dp round back button -->
    <style name="FpTopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

    <style name="FpBackButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:contentDescription">@string/fp_back</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/ic_fp_back</item>
    </style>

    <style name="FpTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/fp_title</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="FpBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/fp_body</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FpInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_fp_input</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:paddingHorizontal">17dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/fp_title</item>
        <item name="android:textColorHint">@color/fp_hint</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="FpFieldError">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textColor">@color/fp_error</item>
        <item name="android:textSize">12sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="FpPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/border_active</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="FpOtpBox">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_fp_otp_box</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/fp_title</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- weighted gap between OTP boxes (Figma: justify-between) -->
    <style name="FpOtpGap">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_weight">1</item>
    </style>

</resources>
