<?xml version="1.0" encoding="utf-8"?>
<!-- Role cards on the landing screen (Figma node 125:900). Selected state comes from
     MaterialCardView.setChecked (stroke) + setSelected (propagates to children). -->
<resources>

    <style name="LandingRoleCard" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardForegroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="checkedIcon">@null</item>
        <item name="strokeColor">@color/account_card_stroke_selector</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="LandingRoleCardRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="LandingRoleIconBg">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_landing_role_icon</item>
    </style>

    <style name="LandingRoleIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/landing_role_icon_tint</item>
    </style>

    <style name="LandingRoleTextColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="LandingRoleTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/landing_role_title</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="LandingRoleSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/landing_role_subtitle</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="LandingRoleChevron">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/arrow_icon</item>
        <item name="tint">@color/landing_role_icon_tint</item>
    </style>

</resources>
