<?xml version="1.0" encoding="utf-8"?>
<!-- Guided camera shutter: white ring, dark green centre (red while recording: set in code) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:id="@+id/shutterCore" android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#1B4332" />
        </shape>
    </item>
</layer-list>
