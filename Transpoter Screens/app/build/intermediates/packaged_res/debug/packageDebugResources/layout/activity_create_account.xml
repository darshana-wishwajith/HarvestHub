<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Top Brand Emblem Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:contentDescription="HarvestHub Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_harvesthub_emblem" />

        <!-- Brand Title: HarvestHub -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Harvest"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Hub"
                android:textColor="#22C55E"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tagline: 2 lines -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="2dp"
            android:text="Register to Next Generation Agricultural\nMarketPlace"
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Create Account Heading (Left Aligned) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Create Account"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Form Inputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Field 1: Full Name -->
            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input_field"
                android:hint="Full Name (e.g., W.B.D.W. Bandara)"
                android:imeOptions="actionNext"
                android:inputType="textCapWords|textPersonName"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <!-- Field 2: Mobile Number -->
            <EditText
                android:id="@+id/etMobile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_login_input_field"
                android:hint="Mobile Number (e.g., 07X XXX XXXX)"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <!-- Field 3: National Identity Card (NIC) with Info Icon -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_login_input_field">

                <EditText
                    android:id="@+id/etNic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="National Identity Card (NIC)"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:singleLine="true"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivNicInfo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="NIC info"
                    android:focusable="true"
                    android:src="@drawable/ic_info_outline" />
            </RelativeLayout>

            <!-- Field 4: Create Password with Eye Toggle -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_login_input_field">

                <EditText
                    android:id="@+id/etCreatePassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Create Password"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:singleLine="true"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivToggleCreatePassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Toggle Password Visibility"
                    android:focusable="true"
                    android:src="@drawable/ic_visibility_eye" />
            </RelativeLayout>

            <!-- Field 5: Confirm Password with Eye Toggle -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_login_input_field">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Confirm Password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:singleLine="true"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivToggleConfirmPassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Toggle Confirm Password Visibility"
                    android:focusable="true"
                    android:src="@drawable/ic_visibility_eye" />
            </RelativeLayout>

        </LinearLayout>

        <!-- Terms of Service Notice -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="2dp"
            android:text="By registering, you agree to HarvestHub's Terms of\nService"
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Continue to Location Setup Button -->
        <LinearLayout
            android:id="@+id/btnContinueLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_sign_in"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue to Location Setup"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Next"
                android:src="@drawable/ic_chevron_right_white" />
        </LinearLayout>

        <!-- Already have an account? Sign In -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#1E293B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSignInLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:text="Sign In"
                android:textColor="#22C55E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
